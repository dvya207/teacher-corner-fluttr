rules_version = '2';

// Rules for the `divya-teacher-corner` database ONLY. Scoped by the `database`
// key in firebase.json, so a deploy from this repo cannot reach `(default)`,
// `teacher-corner-dev` or `sidteachercorner`.
//
// Shape follows what the vertical slice actually does: it reads four
// collections and writes exactly one. Anything wider than that is a hole.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The teacher's own profile, including the denormalised `classrooms` map.
    // Read-only from the app: teacher records are provisioned upstream, so a
    // client that can rewrite its own institution or classroom list is a
    // privilege-escalation path, not a feature.
    match /Teachers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // Evidence submissions are the ONE thing this app writes. Nested match
      // statements are evaluated on their own, so the parent's `write: false`
      // does not close this off.
      match /submissions/{submissionId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Shared reference data. Any signed-in teacher may read it; nothing in this
    // app writes it.
    match /Classrooms/{classroomId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /LearningUnits/{learningUnitId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /Workflows/{workflowId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Stated for the reader, not for the engine: Firestore already denies
    // everything that no rule above matched.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
