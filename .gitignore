# Flutter / Dart
.dart_tool/
.packages
build/
*.iml
.idea/
.vscode/
pubspec.lock

# Firebase — NEVER commit these. Both are per-developer config.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Android signing — NEVER commit.
android/key.properties
*.jks
*.keystore

# Seed script deps — installed locally, never committed.
tools/node_modules/
tools/package-lock.json

# Golden-test failure artefacts. Written by `flutter test` ONLY when a golden
# mismatches, and rewritten on the next mismatch, so they are debug output
# rather than source. Kept on disk for inspection, out of history.
test/golden/failures/
