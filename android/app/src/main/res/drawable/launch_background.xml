<?xml version="1.0" encoding="utf-8"?>
<!-- The window the OS paints before Flutter's first frame: navy + logo, so the
     handover into SplashScreen (same navy, same logo) is invisible rather than a
     white flash. On API 31+ the system SplashScreen API supersedes this; see
     values-v31/styles.xml. The logo is @drawable/tc_launch_logo, generated from
     assets/images/thinktacLogo_white.svg by tools/svg_to_vector_drawable.py. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tc_launch_navy" />
    <item
        android:drawable="@drawable/tc_launch_logo"
        android:gravity="center"
        android:width="160dp"
        android:height="147dp" />
</layer-list>
